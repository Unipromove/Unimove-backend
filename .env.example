# Copie este arquivo para `.env` e ajuste os valores.
# O `.env` esta no .gitignore — nunca commitar segredos reais.

# ----- Banco de dados -----
DATABASE_URL=jdbc:postgresql://localhost:5432/unimove
DATABASE_USER=unimove
DATABASE_PASSWORD=changeme

# ----- JWT -----
# Gere uma chave de pelo menos 256 bits. Sugestao:
#   openssl rand -base64 48
JWT_SECRET=troque-isto-por-uma-chave-aleatoria-de-256-bits
JWT_EXPIRATION_MS=86400000

# ----- OSRM (API de mapas) -----
# Demo publica — sem SLA. Para producao, considerar self-host via Docker.
OSRM_BASE_URL=https://router.project-osrm.org

# ----- Verificacao de telefone (WhatsApp, fluxo reverso) -----
# LOG      = dev/testes: o link e o codigo saem no log e a Meta e simulada
#            por um POST manual em /webhooks/whatsapp (ver docs/api.http).
# WHATSAPP = producao. Exige as tres variaveis abaixo, senao o startup falha.
PHONE_VERIFICATION_CHANNEL=LOG

# Numero da UniMove em E.164 sem '+'. Precisa ser um chip DEDICADO: registrar
# um numero na Cloud API o desvincula do app WhatsApp comum.
WHATSAPP_BUSINESS_NUMBER=
# App Secret do app Meta (Configuracoes > Basico). Valida o HMAC do webhook.
WHATSAPP_APP_SECRET=
# Valor livre que voce escolhe e repete no painel da Meta ao cadastrar a URL.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ----- Login social (Google) -----
# false = dev/testes: /auth/social responde 503 e nenhuma credencial e exigida.
# true  = exige GOOGLE_CLIENT_IDS preenchido, senao o startup falha.
GOOGLE_LOGIN_ENABLED=false

# LISTA separada por virgula. O claim 'aud' do id_token muda por plataforma:
# Android com serverClientId devolve o client ID WEB; iOS devolve o client ID iOS.
# Cadastre um client OAuth por plataforma no Google Cloud Console e liste todos.
GOOGLE_CLIENT_IDS=

# So muda em teste; o default aponta para o JWKS publico do Google.
# GOOGLE_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs

# ----- Spring -----
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ----- Producao (VPS) -----
# Em producao este arquivo vive em /opt/unimove/.env com chmod 600, criado a mao
# UMA VEZ na VPS. Os segredos NAO passam pelo GitHub: o CI so tem credencial de
# SSH, entao rotacionar um segredo nao exige redeploy. Ver docs/deploy-vps.md.
#
# Dominio publico usado pelo Caddy para emitir o certificado Let's Encrypt.
# Trocar DuckDNS por dominio proprio = mudar so esta linha.
# DOMAIN=unimove.duckdns.org
#
# IMAGE_TAG e escrito e atualizado pelo scripts/deploy.sh a cada deploy
# (guarda o SHA do commit para permitir rollback). Nao editar na mao.
